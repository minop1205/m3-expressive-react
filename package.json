{
  "name": "m3-expressive-react",
  "version": "1.0.0",
  "description": "Material Design 3 (Expressive) component library for React — token-first, spec-driven, MUI-idiomatic API",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "tsc -p tsconfig.build.json && vite build",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint:tokens": "! grep -rEn 'var\\(--md-sys-[a-z0-9-]+,' src --include='*.css' && ! grep -rzlE 'var\\(\\s*--md-sys-[a-z0-9-]+\\s*,' src --include='*.css'",
    "prepare": "husky",
    "vrt": "playwright test",
    "vrt:update": "playwright test --update-snapshots"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@material/material-color-utilities": "^0.3.0",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@fontsource/roboto": "^5.2.10",
    "@material-symbols/svg-400": "^0.45.5",
    "@microsoft/api-extractor": "^7.59.2",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^22.19.21",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.10.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "mockdate": "^3.0.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "^10.6.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.1",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.0.1",
    "vitest-axe": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minop1205/md3-react.git"
  },
  "homepage": "https://github.com/minop1205/md3-react#readme",
  "bugs": {
    "url": "https://github.com/minop1205/md3-react/issues"
  },
  "author": "Minoru Okuyama",
  "keywords": [
    "react",
    "material-design",
    "material-design-3",
    "md3",
    "material-you",
    "expressive",
    "components",
    "ui",
    "design-system",
    "design-tokens"
  ]
}
